rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow signed-in users to read/write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated access to the rest of the app data.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
